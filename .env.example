# Copy this file to .env and fill in your credentials.
# Never commit .env.

# --- Scraper ---
# Optional: Google Places API key for enrichment fallback (address, website, phone)
PLACES_API_KEY=

# Optional: override default Playwright user-agent string
SCRAPER_USER_AGENT=

# Throttle between Meta Ad Library requests, in seconds (default 4)
SCRAPER_MIN_DELAY_SECONDS=3
SCRAPER_MAX_DELAY_SECONDS=5

# --- Outreach ---
# Path to Gmail OAuth client_secret JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_PATH=./gmail_credentials.json

# Where the per-inbox OAuth tokens get cached (one file per inbox)
GMAIL_TOKEN_DIR=./.gmail_tokens

# Per-inbox per-day cap on drafts created (hard ceiling enforced by script)
DAILY_DRAFT_CAP=20

# --- Landing page template (per-client; copy into template/.env when cloning) ---
PLAUSIBLE_DOMAIN=
WEB3FORMS_KEY=
