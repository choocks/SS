---
import { client } from '../config/client.ts';
---

<section aria-label="Frequently asked questions" class="bg-gray-50">
  <div class="container-x py-16 sm:py-20">
    {client.faq.headline && (
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
        {client.faq.headline}
      </h2>
    )}

    <div class="mt-10 max-w-3xl space-y-3">
      {client.faq.items.map((item, i) => (
        <details
          class="group rounded-xl bg-white p-5 ring-1 ring-gray-200 open:ring-brand/40 transition-shadow"
          open={i === 0}
        >
          <summary class="cursor-pointer list-none flex items-center justify-between gap-4 text-base sm:text-lg font-semibold text-gray-900">
            <span>{item.q}</span>
            <span
              aria-hidden="true"
              class="flex h-7 w-7 flex-none items-center justify-center rounded-full bg-gray-100 text-gray-700 transition-transform group-open:rotate-45"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M12 5v14M5 12h14"></path>
              </svg>
            </span>
          </summary>
          <p class="mt-3 text-gray-600 leading-relaxed">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  details > summary::-webkit-details-marker { display: none; }
  .ring-brand\/40 {
    --tw-ring-color: color-mix(in srgb, var(--color-brand) 40%, white);
  }
</style>
