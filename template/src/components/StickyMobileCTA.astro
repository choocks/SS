---
import { client } from '../config/client.ts';
---

<div
  aria-hidden="false"
  class="md:hidden fixed bottom-0 inset-x-0 z-40 border-t border-gray-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80 px-4 py-3 shadow-[0_-4px_20px_rgba(0,0,0,0.06)]"
>
  <div class="flex gap-2">
    <a
      href="#book"
      class="btn-primary flex-1 plausible-event-name=mobile_cta_click"
    >
      {client.hero.primaryCtaLabel}
    </a>
    <a
      href={`tel:${client.contact.phoneTel}`}
      aria-label={`Call ${client.contact.phoneDisplay}`}
      class="btn btn-secondary px-4 plausible-event-name=phone_click"
    >
      <svg
        aria-hidden="true"
        class="h-5 w-5 text-brand"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"></path>
      </svg>
    </a>
  </div>
</div>
