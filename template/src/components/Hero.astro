---
import { client } from '../config/client.ts';
import LeadForm from './LeadForm.astro';
---

<section class="relative overflow-hidden bg-gradient-to-b from-gray-50 to-white">
  <div class="container-x py-12 sm:py-16 lg:py-20">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div>
        {client.hero.eyebrow && (
          <span class="eyebrow">{client.hero.eyebrow}</span>
        )}

        <h1 class="mt-3 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-gray-900">
          {client.hero.headline}
        </h1>

        <p class="mt-5 text-lg sm:text-xl text-gray-600 max-w-prose">
          {client.hero.subhead}
        </p>

        <div class="mt-8">
          <LeadForm variant="hero" submitLabel={client.hero.primaryCtaLabel} />
        </div>

        <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-700">
          {client.trustMarkers.map((marker) => (
            <li class="flex items-center gap-2">
              <svg
                aria-hidden="true"
                class="h-4 w-4 text-brand flex-none"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
              <span>{marker}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="relative">
        <img
          src={client.hero.image}
          alt={client.hero.imageAlt}
          width={client.hero.imageWidth}
          height={client.hero.imageHeight}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="rounded-2xl shadow-xl object-cover w-full h-auto bg-gray-100"
        />
      </div>
    </div>
  </div>
</section>
