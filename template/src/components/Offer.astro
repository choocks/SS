---
import { client } from '../config/client.ts';
import LeadForm from './LeadForm.astro';
---

<section aria-label="Offer" class="bg-gray-50">
  <div class="container-x py-16 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16 items-start">
      <div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
          {client.offer.headline}
        </h2>
        {client.offer.subhead && (
          <p class="mt-4 text-lg text-gray-600">{client.offer.subhead}</p>
        )}

        <ul class="mt-8 space-y-3">
          {client.offer.bullets.map((b) => (
            <li class="flex gap-3">
              <svg
                aria-hidden="true"
                class="h-6 w-6 flex-none text-brand"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="text-gray-800">{b}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl bg-white p-6 sm:p-8 shadow-md ring-1 ring-gray-200">
        {client.offer.price && (
          <div class="text-center">
            <p class="text-5xl font-bold text-gray-900">{client.offer.price}</p>
            {client.offer.priceNote && (
              <p class="mt-2 text-sm text-gray-500">{client.offer.priceNote}</p>
            )}
          </div>
        )}

        <div class="mt-6 border-t border-gray-100 pt-6">
          <LeadForm submitLabel={client.offer.ctaLabel} />
        </div>

        <ul class="mt-6 flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs text-gray-500">
          {client.trustMarkers.map((m) => (
            <li>· {m}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
