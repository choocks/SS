---
import { client } from '../config/client.ts';
---

<section aria-label="Social proof" class="border-y border-gray-200 bg-white">
  <div class="container-x py-8 sm:py-10">
    {client.socialProof.headline && (
      <p class="text-center text-sm font-medium uppercase tracking-widest text-gray-500">
        {client.socialProof.headline}
      </p>
    )}

    <ul
      class:list={[
        'mt-6 grid gap-6 text-center',
        client.socialProof.items.length === 4
          ? 'grid-cols-2 sm:grid-cols-4'
          : 'grid-cols-2 sm:grid-cols-3',
      ]}
    >
      {client.socialProof.items.map((item) => (
        <li>
          <p class="text-2xl sm:text-3xl font-bold text-gray-900">{item.label}</p>
          {item.sub && (
            <p class="mt-1 text-sm text-gray-500">{item.sub}</p>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
